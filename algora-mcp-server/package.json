{
  "name": "algora-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Algora — lets AI agents discover, browse, and analyze open source bounties",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "algora-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "algora",
    "bounties",
    "open-source",
    "ai-agent",
    "typescript"
  ],
  "author": "IDAPIXL",
  "license": "MIT",
  "dependencies": {
    "@algora/sdk": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.5.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
